# Public discovery endpoint used by AniList loaders and client queries.
# Override this with a deterministic local mock when running Playwright.
VITE_ANILIST_API_URL=https://graphql.anilist.co

# Public playback endpoint used only after the Watch route mounts in the browser.
# Override this with a deterministic local mock when running Playwright.
VITE_ANISOURCE_BASE=https://anisource-api.onrender.com

# Never place credentials or private tokens in VITE_ variables: Vite embeds them
# in browser assets. Server-only secrets belong in Vercel environment settings.
