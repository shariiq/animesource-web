# Optional public API overrides. Defaults live in config/api-urls.json.
# Override these with deterministic local mocks when running Playwright.
# VITE_ANILIST_API_URL=https://graphql.anilist.co

# Server-only AniSource gateway configuration. Never use a VITE_ prefix here.
# Optional override; the default is in config/api-urls.json.
# ANISOURCE_BASE=
# ANISOURCE_SERVICE_TOKEN=
# ANISOURCE_SESSION_SECRET=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Serve API media bytes (segments, keys, subtitles, manga pages) straight
# from the API deployment instead of streaming them through this gateway.
# Catalog JSON still resolves here, so the service credential stays hidden.
# Enable only after the API deployment sets short segment TTLs
# (HLS_PROXY_SEGMENT_TTL) and the site origin allowlist
# (MEDIA_ALLOWED_ORIGINS); otherwise exposed bearer URLs stay replayable
# with no hotlink check. Default off: session-bound asset tickets.
# ANISOURCE_DIRECT_MEDIA=

# Optional public live-smoke override; the smoke test never sends API credentials.
# LIVE_ANISOURCE_BASE=
