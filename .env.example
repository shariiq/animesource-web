# Optional public API overrides. Defaults live in config/api-urls.json.
# Override these with deterministic local mocks when running Playwright.
# VITE_ANILIST_API_URL=https://graphql.anilist.co

# Server-only AniSource gateway configuration. Never use a VITE_ prefix here.
# Optional override; the default is in config/api-urls.json.
# ANISOURCE_BASE=
# ANISOURCE_SERVICE_TOKEN=
# ANISOURCE_SESSION_SECRET=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional public live-smoke override; the smoke test never sends API credentials.
# LIVE_ANISOURCE_BASE=
